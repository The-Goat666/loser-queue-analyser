# ── Helper: rate-limit-safe GET ──────────────────────────────────────────────
def safe_get(url, retries=5):
    for attempt in range(retries):
        r = requests.get(url)
        if r.status_code == 200:
            return r.json()
        elif r.status_code == 429:
            wait = int(r.headers.get("Retry-After", 5))
            print(f"  Rate limited — waiting {wait}s")
            time.sleep(wait + 1)
        else:
            print(f"  Bad status {r.status_code}: {r.text}")
            return None
    return None

TIER_ORDER = ["IRON", "BRONZE", "SILVER", "GOLD", "PLATINUM", "EMERALD", "DIAMOND", "MASTER", "GRANDMASTER", "CHALLENGER"]
DIV_ORDER  = {"IV": 0, "III": 1, "II": 2, "I": 3}

def rank_to_num(rank_str):
    if rank_str == "Unranked":
        return None
    parts = rank_str.upper().split()
    if len(parts) == 1:  # MASTER/GRANDMASTER/CHALLENGER have no division
        tier = parts[0]
        if tier in TIER_ORDER:
            return TIER_ORDER.index(tier) * 4
        return None
    tier, div = parts[0], parts[1]
    if tier not in TIER_ORDER or div not in DIV_ORDER:
        return None
    return TIER_ORDER.index(tier) * 4 + DIV_ORDER[div]

def num_to_rank(n):
    if n is None:
        return "Unranked"
    n = round(n)
    tier_idx = n // 4
    div_idx  = n % 4
    tier_idx = max(0, min(tier_idx, len(TIER_ORDER) - 1))
    tier = TIER_ORDER[tier_idx]
    if tier in ("MASTER", "GRANDMASTER", "CHALLENGER"):
        return tier.capitalize()
    divs = ["IV", "III", "II", "I"]
    return f"{tier.capitalize()} {divs[div_idx]}"


