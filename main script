def get_rank(summoner_id):
    url = f"https://sea.api.riotgames.com/lol/league/v4/entries/by-summoner/{summoner_id}?api_key={API_KEY}"
    data = safe_get(url)
    if not data:
        return "Unranked"
    for entry in data:
        if entry["queueType"] == "RANKED_SOLO_5x5":
            return f"{entry['tier']} {entry['rank']}"
    return "Unranked"

def get_rank_cached(summoner_id):
    if summoner_id in rank_cache:
        return rank_cache[summoner_id]
    rank = get_rank(summoner_id)
    rank_cache[summoner_id] = rank
    return rank


